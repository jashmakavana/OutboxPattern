{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "OutboxPattern.Api.BackgroundServices": "Information",
      "OutboxPattern.Api.Services": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=OutboxPatternDb;Trusted_Connection=True;"
  },
  "OutboxWorker": {
    "PollingIntervalSeconds": 5,
    "BatchSize": 20,
    "MaxRetries": 3
  }
}